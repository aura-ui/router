{
  "name": "aura-ui-router",
  "version": "0.0.1",
  "description": "Framework-agnostic Web Components router for SSR-first apps with seamless SPA transitions and predictable route lifecycle hooks.",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:watch": "chokidar \"src/**/*.{ts,tsx}\" -c \"npm run lint\"",
    "check": "npm run lint && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "commitlint": "commitlint --edit",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aura-ui/router.git"
  },
  "keywords": [
    "Web Components",
    "SPA",
    "SSR",
    "Aura UI"
  ],
  "author": "Aleksandr Buryakov",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/aura-ui/router/issues"
  },
  "homepage": "https://github.com/aura-ui/router#readme",
  "devDependencies": {
    "@commitlint/cli": "^20.5.2",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/js": "^9.39.4",
    "chokidar-cli": "^3.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-security": "^4.0.0",
    "eslint-plugin-unicorn": "^64.0.0",
    "globals": "^17.5.0",
    "husky": "^9.1.7",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.1",
    "vite": "^8.0.10"
  },
  "dependencies": {
    "navigo": "^8.11.1"
  }
}
