{
  "name": "@auraui/router",
  "version": "0.3.0",
  "description": "HTML-first client navigation for real HTML pages (MPA→SPA). Works with plain HTML, Web Components, or Lit.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "LIMITATIONS.md",
    "docs/tutorial.md",
    "docs/guide.md",
    "docs/guide/*",
    "docs/recipes/*",
    "docs/what-aura-is-not.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-lib.mjs",
    "build:demo": "vite build",
    "build:smoke": "npm run build && npm run smoke",
    "preview": "vite preview",
    "prepublishOnly": "npm run build",
    "smoke": "node scripts/smoke-dist.mjs",
    "size": "size-limit",
    "size:analyze": "size-limit --why",
    "size:vite": "node scripts/measure-app-bundle.mjs",
    "size:report": "npm run size && npm run size:analyze",
    "test": "jest",
    "bench:cache": "tsx src/modules/aura-cache/bench/aura-swr-cache.bench.ts",
    "bench:cache:gc": "node --expose-gc node_modules/tsx/dist/cli.mjs src/modules/aura-cache/bench/aura-swr-cache.bench.ts",
    "bench": "tsx bench/run-all.ts",
    "bench:gc": "node --expose-gc node_modules/tsx/dist/cli.mjs bench/run-all.ts",
    "bench:url-matcher": "tsx bench/scenarios/url-matcher.bench.ts",
    "bench:matched-chain": "tsx bench/scenarios/matched-chain.bench.ts",
    "bench:transition-plan": "tsx bench/scenarios/transition-plan.bench.ts",
    "bench:prefetch-plan": "tsx bench/scenarios/prefetch-plan.bench.ts",
    "bench:dom-patch": "tsx bench/scenarios/dom-patch.bench.ts",
    "bench:route-tree": "tsx bench/scenarios/route-tree.bench.ts",
    "bench:navigation-pipeline": "tsx bench/scenarios/navigation-pipeline.bench.ts",
    "bench:data-graph": "tsx bench/scenarios/data-graph.bench.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:watch": "chokidar \"src/**/*.{ts,tsx}\" -c \"npm run lint\"",
    "check": "npm run lint && npm run build:smoke",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "commitlint": "commitlint --edit",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aura-ui/router.git"
  },
  "keywords": [
    "aura-ui",
    "auraui",
    "web-components",
    "custom-element",
    "custom-elements",
    "client-side-routing",
    "lit",
    "router",
    "html-first",
    "mpa",
    "spa",
    "progressive-enhancement",
    "typescript"
  ],
  "author": "Aleksandr Buryakov",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/aura-ui/router/issues"
  },
  "homepage": "https://github.com/aura-ui/router#readme",
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^9.39.4",
    "@size-limit/esbuild-why": "^13.0.3",
    "@size-limit/preset-small-lib": "^13.0.3",
    "@types/jest": "^30.0.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "chokidar-cli": "^3.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-security": "^4.0.0",
    "eslint-plugin-unicorn": "^64.0.0",
    "globals": "^17.11.0",
    "highlight.js": "^11.12.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "size-limit": "^13.0.3",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.12",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.67.0",
    "urlpattern-polyfill": "^10.1.0",
    "vite": "^8.2.2"
  }
}
