{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "types": [],
    "noEmit": false
  },
  "include": ["src/index.ts", "src/modules/**/*.ts"],
  "exclude": [
    "src/**/test/**",
    "src/**/bench/**",
    "src/examples/**",
    "src/**/__depricated/**"
  ]
}
